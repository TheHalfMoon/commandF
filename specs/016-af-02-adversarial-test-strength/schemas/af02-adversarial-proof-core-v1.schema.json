        "af01_assurance_projection_sha256":{"$ref":"#/$defs/sha256"},"af01_review_projection_sha256":{"$ref":"#/$defs/sha256"},"cf06_projection_sha256":{"$ref":"#/$defs/sha256"},"cf10_projection_sha256":{"$ref":"#/$defs/sha256"},"live_readback_completed":{"const":true}
