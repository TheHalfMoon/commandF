      }
    },
    "stochastic_observations":{"type":"array","items":{"$ref":"#/$defs/stochasticObservation"}},
    "af02_adversarial_sha256":{"$ref":"#/$defs/sha256"}
  },
  "$defs":{
    "gitSha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
