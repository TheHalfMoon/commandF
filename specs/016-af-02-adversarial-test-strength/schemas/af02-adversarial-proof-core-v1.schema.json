      "type":"object","additionalProperties":false,
      "required":["descriptor_sha256","exclusion_policy_sha256","raw_report_sha256","source_universe_sha256","file_metrics_sha256","workspace_covered_lines","workspace_total_lines","workspace_floor_percent","critical_surface_metrics_sha256","unknown_production_path_count","missing_production_path_count","duplicate_normalized_path_count"],
      "properties":{"descriptor_sha256":{"$ref":"#/$defs/sha256"},"exclusion_policy_sha256":{"$ref":"#/$defs/sha256"},"raw_report_sha256":{"$ref":"#/$defs/sha256"},"source_universe_sha256":{"$ref":"#/$defs/sha256"},"file_metrics_sha256":{"$ref":"#/$defs/sha256"},"workspace_covered_lines":{"$ref":"#/$defs/nonNegative"},"workspace_total_lines":{"$ref":"#/$defs/positive"},"workspace_floor_percent":{"type":"integer","minimum":0,"maximum":100},"critical_surface_metrics_sha256":{"$ref":"#/$defs/sha256"},"unknown_production_path_count":{"const":0},"missing_production_path_count":{"const":0},"duplicate_normalized_path_count":{"const":0}}
    },
