      "properties":{"command_argv_sha256":{"$ref":"#/$defs/sha256"},"source_sha":{"$ref":"#/$defs/gitSha"},"exit_code":{"const":0},"test_count":{"$ref":"#/$defs/nonNegative"},"passed_count":{"$ref":"#/$defs/nonNegative"},"failed_count":{"const":0},"ignored_count":{"$ref":"#/$defs/nonNegative"},"raw_result_sha256":{"$ref":"#/$defs/sha256"}}
    },
    "checkBase":{
      "type":"object","additionalProperties":false,
      "required":["context","integration_id","check_run_id","head_sha","conclusion"],
      "properties":{"context":{"type":"string"},"integration_id":{"const":15368},"check_run_id":{"$ref":"#/$defs/positive"},"head_sha":{"$ref":"#/$defs/gitSha"},"conclusion":{"const":"success"}}
