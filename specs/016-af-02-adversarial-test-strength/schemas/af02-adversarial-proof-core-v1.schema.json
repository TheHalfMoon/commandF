    "cargoLlvmCov":{"allOf":[{"$ref":"#/$defs/execTool"},{"properties":{"id":{"const":"cargo-llvm-cov"},"version":{"const":"0.9.0"},"upstream_repository":{"const":"https://github.com/taiki-e/cargo-llvm-cov"},"upstream_commit":{"const":"be59056988acd54c7f984b7c85643daea3711b29"},"features":{"const":[]}}}]},
    "cargoMutants":{"allOf":[{"$ref":"#/$defs/execTool"},{"properties":{"id":{"const":"cargo-mutants"},"version":{"const":"27.1.0"},"upstream_repository":{"const":"https://github.com/sourcefrog/cargo-mutants"},"upstream_commit":{"const":"8ab1dc786a1f61a4e370416cc6c68b81a704e917"},"features":{"const":[]}}}]},
    "cargoNextest":{"allOf":[{"$ref":"#/$defs/execTool"},{"properties":{"id":{"const":"cargo-nextest"},"version":{"const":"0.9.143"},"upstream_repository":{"const":"https://github.com/nextest-rs/nextest"},"upstream_commit":{"const":"60fa45f638ffc3f35e74afa65737f45fcd32db2a"},"features":{"const":[]}}}]},
