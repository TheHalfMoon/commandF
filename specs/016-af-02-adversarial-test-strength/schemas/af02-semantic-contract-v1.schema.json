{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://commandf.dev/schemas/af02-semantic-contract-v1.schema.json","title":"commandf.af02-semantic-contract/v1","type":"object","additionalProperties":false,"required":["schema","verifier","algorithms","negative_fixture_ids"],
